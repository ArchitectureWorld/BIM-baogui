{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "guidNamespace",
    "evidenceSources",
    "properties",
    "carrierRoles",
    "modelProfiles",
    "conditions",
    "tasks",
    "legacyAliases",
    "stage01"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packageId": {
      "type": "string"
    },
    "packageVersion": {
      "type": "string"
    },
    "guidNamespace": {
      "type": "string",
      "format": "uuid"
    },
    "evidenceSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSourceContract" }
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyRule"
      }
    },
    "carrierRoles": {
      "type": "array",
      "items": { "$ref": "#/$defs/carrierRoleContract" }
    },
    "modelProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelProfileContract" }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionContract"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskContract"
      }
    },
    "legacyAliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacyAliasContract" }
    },
    "stage01": {
      "$ref": "#/$defs/stage01Contract"
    }
  },
  "$defs": {
    "propertyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "canonicalKey",
        "contractKind",
        "source",
        "ifc",
        "revit",
        "officialPlugin",
        "carrierRoleIds",
        "requirement",
        "stageOwnership",
        "suggestion",
        "ifcWrite"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "format": "uuid"
        },
        "canonicalKey": {
          "type": "string"
        },
        "contractKind": {
          "enum": [
            "MVD",
            "HIFC_EXTENSION"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceContract"
        },
        "ifc": {
          "$ref": "#/$defs/ifcContract"
        },
        "revit": {
          "$ref": "#/$defs/revitContract"
        },
        "officialPlugin": {
          "$ref": "#/$defs/officialPluginContract"
        },
        "carrierRoleIds": {
          "type": "array"
        },
        "requirement": {
          "type": "object"
        },
        "stageOwnership": {
          "type": "array"
        },
        "suggestion": {
          "type": "object",
          "required": [
            "kind",
            "aliases"
          ]
        },
        "ifcWrite": {
          "type": "object"
        },
        "extensionReason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contractKind": {
                "const": "HIFC_EXTENSION"
              }
            }
          },
          "then": {
            "required": [
              "extensionReason"
            ]
          }
        }
      ]
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sheet",
        "row",
        "rawEntityCn",
        "rawEntityId",
        "rawIfcElementOrType",
        "rawPropertySetId",
        "rawPropertySetName",
        "rawProperty",
        "rawValueKind",
        "rawDeclaredType",
        "rawUnit"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "rawEntityCn": {
          "type": "string"
        },
        "rawEntityId": {
          "type": "string"
        },
        "rawIfcElementOrType": {
          "type": "string"
        },
        "rawPropertySetId": {
          "type": "string"
        },
        "rawPropertySetName": {
          "type": "string"
        },
        "rawProperty": {
          "type": "string"
        },
        "rawValueKind": {
          "type": "string"
        },
        "rawDeclaredType": {
          "type": "string"
        },
        "rawUnit": {
          "type": "string"
        },
        "row": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "ifcContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "propertySet",
        "property",
        "sourceUnit",
        "declaredType",
        "canonicalUnit",
        "allowedRuntimeTypes"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "propertySet": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "sourceUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaredType": {
          "type": "string"
        },
        "canonicalUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowedRuntimeTypes": {
          "type": "array"
        }
      }
    },
    "revitContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterGuid",
        "parameterName",
        "legacyNames",
        "visible",
        "userModifiable",
        "bindingScope",
        "storageType",
        "parameterType"
      ],
      "properties": {
        "parameterGuid": {
          "type": "string",
          "format": "uuid"
        },
        "parameterName": {
          "type": "string"
        },
        "legacyNames": {
          "type": "array"
        },
        "visible": {
          "type": "boolean"
        },
        "userModifiable": {
          "type": "boolean"
        },
        "bindingScope": {
          "type": "string"
        },
        "storageType": {
          "type": "string"
        },
        "parameterType": {
          "type": "string"
        }
      }
    },
    "officialPluginContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inExtracted166",
        "evidenceStatus",
        "originalIdentity"
      ],
      "properties": {
        "inExtracted166": {
          "type": "boolean"
        },
        "evidenceStatus": {
          "type": "string",
          "minLength": 1
        },
        "originalIdentity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taskContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "modelFileType",
        "name",
        "objectCode",
        "requirement",
        "conditionId",
        "sequence",
        "skeletonTask",
        "attributeRequirements",
        "dependencies",
        "geometryChecks",
        "propertyChecks",
        "targetComparisons",
        "source"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "modelFileType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "objectCode": {
          "type": "string"
        },
        "requirement": {
          "type": "string"
        },
        "conditionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer"
        },
        "skeletonTask": {
          "type": "boolean"
        },
        "attributeRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometryChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "propertyChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetComparisons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    "conditionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionId",
        "displayName",
        "group",
        "activationRuleId",
        "evidenceStatus",
        "source"
      ],
      "properties": {
        "conditionId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "activationRuleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceStatus": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "evidenceSourceContract": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": {"type":"string"}, "sheet": {"type":"string"}, "range": {"type":"string"}, "count": {"type":"integer"} } },
    "cardinalityContract": { "type": "object", "additionalProperties": false, "required": ["min","max"], "properties": { "min": {"type":"integer","minimum":0}, "max": {"type":["integer","null"],"minimum":0} } },
    "carrierRoleContract": { "type":"object", "additionalProperties":false, "required":["roleId","displayName","modelFileTypes","ifcEntity","revitCategories","allowedElementKinds","nameAliases","familyAliases","typeAliases","cardinality","selectionPolicy","ifcOwnerStrategy"], "properties": { "roleId":{"type":"string"},"displayName":{"type":"string"},"modelFileTypes":{"type":"array","items":{"type":"string"}},"ifcEntity":{"type":"string"},"revitCategories":{"type":"array","items":{"type":"string"}},"allowedElementKinds":{"type":"array","items":{"type":"string"}},"nameAliases":{"type":"array","items":{"type":"string"}},"familyAliases":{"type":"array","items":{"type":"string"}},"typeAliases":{"type":"array","items":{"type":"string"}},"cardinality":{"$ref":"#/$defs/cardinalityContract"},"selectionPolicy":{"type":"string"},"ifcOwnerStrategy":{"type":"string"} } },
    "modelProfileContract": { "type":"object", "additionalProperties":false, "required":["profileId","taskIds"], "properties": {"profileId":{"type":"string"},"taskIds":{"type":"array","items":{"type":"string"}}} },
    "legacyAliasContract": { "type":"object", "additionalProperties":false, "required":["propertyId","alias"], "properties":{"propertyId":{"type":"string","format":"uuid"},"alias":{"type":"string"}} },
    "stage01FieldRefContract": { "type":"object", "additionalProperties":false, "required":["fieldKey","propertyId","sourceRow"], "properties":{"fieldKey":{"type":"string"},"propertyId":{"type":"string","format":"uuid"},"sourceRow":{"type":"integer","minimum":2}} },
    "stage01Contract": { "type":"object", "additionalProperties":false, "required":["fieldRefs"], "properties":{"fieldRefs":{"type":"array","items":{"$ref":"#/$defs/stage01FieldRefContract"}}} }
  }
}
