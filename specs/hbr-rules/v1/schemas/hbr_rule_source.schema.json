{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "guidNamespace",
    "evidenceSources",
    "properties",
    "carrierRoles",
    "modelProfiles",
    "conditions",
    "tasks",
    "legacyAliases",
    "stage01"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packageId": {
      "type": "string"
    },
    "packageVersion": {
      "type": "string"
    },
    "guidNamespace": {
      "type": "string",
      "format": "uuid"
    },
    "evidenceSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceSourceContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyRule"
      }
    },
    "carrierRoles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/carrierRoleContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modelProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelProfileContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "legacyAliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyAliasContract"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stage01": {
      "$ref": "#/$defs/stage01Contract"
    }
  },
  "$defs": {
    "propertyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "canonicalKey",
        "contractKind",
        "source",
        "ifc",
        "revit",
        "officialPlugin",
        "carrierRoleIds",
        "requirement",
        "stageOwnership",
        "suggestion",
        "ifcWrite"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "format": "uuid"
        },
        "canonicalKey": {
          "type": "string"
        },
        "contractKind": {
          "enum": [
            "MVD",
            "HIFC_EXTENSION"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceContract"
        },
        "ifc": {
          "$ref": "#/$defs/ifcContract"
        },
        "revit": {
          "$ref": "#/$defs/revitContract"
        },
        "officialPlugin": {
          "$ref": "#/$defs/officialPluginContract"
        },
        "carrierRoleIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requirement": {
          "$ref": "#/$defs/requirementContract"
        },
        "stageOwnership": {
          "type": "array",
          "items": {
            "enum": [
              "STAGE01",
              "STAGE02",
              "STAGE03"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "suggestion": {
          "$ref": "#/$defs/suggestionContract"
        },
        "ifcWrite": {
          "$ref": "#/$defs/ifcWriteContract"
        },
        "extensionReason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contractKind": {
                "const": "HIFC_EXTENSION"
              }
            }
          },
          "then": {
            "required": [
              "extensionReason"
            ]
          }
        }
      ]
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sheet",
        "row",
        "rawEntityCn",
        "rawEntityId",
        "rawIfcElementOrType",
        "rawPropertySetId",
        "rawPropertySetName",
        "rawProperty",
        "rawValueKind",
        "rawDeclaredType",
        "rawUnit"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "rawEntityCn": {
          "type": "string"
        },
        "rawEntityId": {
          "type": "string"
        },
        "rawIfcElementOrType": {
          "type": "string"
        },
        "rawPropertySetId": {
          "type": "string"
        },
        "rawPropertySetName": {
          "type": "string"
        },
        "rawProperty": {
          "type": "string"
        },
        "rawValueKind": {
          "type": "string"
        },
        "rawDeclaredType": {
          "type": "string"
        },
        "rawUnit": {
          "type": "string"
        },
        "row": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "ifcContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "propertySet",
        "property",
        "sourceUnit",
        "declaredType",
        "canonicalUnit",
        "allowedRuntimeTypes"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "propertySet": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "sourceUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaredType": {
          "type": "string"
        },
        "canonicalUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowedRuntimeTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "revitContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterGuid",
        "parameterName",
        "legacyNames",
        "visible",
        "userModifiable",
        "bindingScope",
        "storageType",
        "parameterType"
      ],
      "properties": {
        "parameterGuid": {
          "type": "string",
          "format": "uuid"
        },
        "parameterName": {
          "type": "string"
        },
        "legacyNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "visible": {
          "type": "boolean"
        },
        "userModifiable": {
          "type": "boolean"
        },
        "bindingScope": {
          "type": "string"
        },
        "storageType": {
          "type": "string"
        },
        "parameterType": {
          "type": "string"
        }
      }
    },
    "officialPluginContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inExtracted166",
        "evidenceStatus",
        "originalIdentity"
      ],
      "properties": {
        "inExtracted166": {
          "type": "boolean"
        },
        "evidenceStatus": {
          "type": "string",
          "minLength": 1
        },
        "originalIdentity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taskContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "modelFileType",
        "name",
        "objectCode",
        "requirement",
        "conditionId",
        "sequence",
        "skeletonTask",
        "attributeRequirements",
        "dependencies",
        "geometryChecks",
        "propertyChecks",
        "targetComparisons",
        "source"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "modelFileType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "objectCode": {
          "type": "string"
        },
        "requirement": {
          "enum": [
            "REQUIRED",
            "CONDITIONAL"
          ]
        },
        "conditionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer"
        },
        "skeletonTask": {
          "type": "boolean"
        },
        "attributeRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "geometryChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "propertyChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "targetComparisons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirement": {
                "const": "CONDITIONAL"
              }
            }
          },
          "then": {
            "properties": {
              "conditionId": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "conditionId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "conditionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionId",
        "displayName",
        "group",
        "activationRuleId",
        "evidenceStatus",
        "source"
      ],
      "properties": {
        "conditionId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "activationRuleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceStatus": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "requirementContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "conditionId"
      ],
      "properties": {
        "level": {
          "enum": [
            "REQUIRED",
            "CONDITIONAL",
            "OPTIONAL",
            "NOT_APPLICABLE",
            "UNCLASSIFIED"
          ]
        },
        "conditionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "suggestionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "aliases"
      ],
      "properties": {
        "kind": {
          "enum": [
            "EXISTING_OR_ALIAS"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "ifcWriteContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writeStrategy",
        "ownerStrategy"
      ],
      "properties": {
        "writeStrategy": {
          "enum": [
            "CREATE_OR_UPDATE_PSET"
          ]
        },
        "ownerStrategy": {
          "enum": [
            "SINGLE_ENTITY_BY_TYPE",
            "BY_EXPORT_GUID",
            "USER_SELECTED_EXPORTABLE_GENERIC_MODEL",
            "CANONICAL_SPATIAL_ZONE_RECORD"
          ]
        }
      }
    },
    "evidenceSourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sheet": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "《MVD》规划报建.xlsx"
              }
            }
          },
          "then": {
            "required": [
              "sha256",
              "sheet",
              "range"
            ]
          }
        }
      ]
    },
    "cardinalityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "carrierRoleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "displayName",
        "modelFileTypes",
        "ifcEntity",
        "revitCategories",
        "allowedElementKinds",
        "nameAliases",
        "familyAliases",
        "typeAliases",
        "cardinality",
        "selectionPolicy",
        "ifcOwnerStrategy"
      ],
      "properties": {
        "roleId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "modelFileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "ifcEntity": {
          "type": "string"
        },
        "revitCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "allowedElementKinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "nameAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "familyAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "typeAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cardinality": {
          "$ref": "#/$defs/cardinalityContract"
        },
        "selectionPolicy": {
          "type": "string"
        },
        "ifcOwnerStrategy": {
          "type": "string"
        }
      }
    },
    "modelProfileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "taskIds"
      ],
      "properties": {
        "profileId": {
          "type": "string"
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "legacyAliasContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "alias"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "format": "uuid"
        },
        "alias": {
          "type": "string"
        }
      }
    },
    "stage01FieldRefContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldKey",
        "propertyId",
        "sourceRow"
      ],
      "properties": {
        "fieldKey": {
          "type": "string"
        },
        "propertyId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceRow": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "stage01Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldRefs"
      ],
      "properties": {
        "fieldRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage01FieldRefContract"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
