  <Target Name="InitializeHbrRulePackPath">
    <PropertyGroup>
      <HbrRulePack Condition="'$(HbrRulePack)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'HBR_RulePack.hbrpack'))</HbrRulePack>
    </PropertyGroup>
    <ItemGroup>
      <UpToDateCheckInput Include="$(HbrRuleSource)" />
      <UpToDateCheckInput Include="$(HbrRulePackCompiler)" />
      <UpToDateCheckInput Include="$(HbrCompatibilityBaseline)" />
      <UpToDateCheckBuilt Include="$(HbrRulePack)"
                          Original="$(HbrRuleSource)" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareHbrRulePackResource"
          DependsOnTargets="InitializeHbrRulePackPath"
          BeforeTargets="CollectUpToDateCheckInputDesignTime;CollectUpToDateCheckBuiltDesignTime" />

  <Target Name="CompileHbrRulePack"
          DependsOnTargets="InitializeHbrRulePackPath"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(HbrRuleSource);$(HbrRulePackCompiler);$(HbrCompatibilityBaseline)"
          Outputs="$(HbrRulePack)">
    <Error Condition="!Exists('$(HbrRuleSource)')"
           Text="HBR rule source not found: $(HbrRuleSource)" />
    <Error Condition="!Exists('$(HbrRulePackCompiler)')"
           Text="HBR rule-pack compiler not found: $(HbrRulePackCompiler)" />
    <Error Condition="!Exists('$(HbrCompatibilityBaseline)')"
           Text="HBR compatibility baseline not found: $(HbrCompatibilityBaseline)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="PYTHONUTF8=1"
          Command="&quot;$(HbrPythonExe)&quot; &quot;$(HbrRulePackCompiler)&quot; --source &quot;$(HbrRuleSource)&quot; --baseline &quot;$(HbrCompatibilityBaseline)&quot; --output &quot;$(HbrRulePack)&quot;" />
    <Error Condition="!Exists('$(HbrRulePack)')"
           Text="HBR rule-pack compiler exited without creating: $(HbrRulePack)" />
  </Target>

  <Target Name="RegisterHbrRulePackResource"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="InitializeHbrRulePackPath;CompileHbrRulePack">
    <ItemGroup>
      <EmbeddedResource Include="$(HbrRulePack)"
                        LogicalName="BIMBaoGui.Stage01.Resources.HBR_RulePack.hbrpack" />
      <FileWrites Include="$(HbrRulePack)" />
    </ItemGroup>
  </Target>

  <Target Name="StageHbrProductionAssemblyForTests"
          AfterTargets="Build"
          DependsOnTargets="PrepareProjectReferences">
    <ItemGroup>
      <_HbrProductionProjectReference Include="@(_MSBuildProjectReferenceExistent)"
                                      Condition="'%(_MSBuildProjectReferenceExistent.HbrProductionAssembly)' == 'true'" />
    </ItemGroup>
    <Error Condition="'@(_HbrProductionProjectReference->Count())' != '1'"
           Text="Expected exactly one existing HBR production ProjectReference, but found @(_HbrProductionProjectReference->Count())." />
    <MSBuild Projects="@(_HbrProductionProjectReference)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_HbrProductionProjectReference.SetConfiguration); %(_HbrProductionProjectReference.SetPlatform); %(_HbrProductionProjectReference.SetTargetFramework)"
             RemoveProperties="%(_HbrProductionProjectReference.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)">
      <Output TaskParameter="TargetOutputs" ItemName="_HbrProductionTargetOutputs" />
    </MSBuild>
    <ItemGroup>
      <_HbrProductionAssembly Include="@(_HbrProductionTargetOutputs)"
                              Condition="'%(_HbrProductionTargetOutputs.Filename)%(_HbrProductionTargetOutputs.Extension)' == 'BIMBaoGui.Stage01.dll'" />
    </ItemGroup>
    <Error Condition="'@(_HbrProductionAssembly->Count())' != '1'"
           Text="Expected exactly one BIMBaoGui.Stage01.dll TargetOutput, but found @(_HbrProductionAssembly->Count()): @(_HbrProductionTargetOutputs)." />
    <PropertyGroup>
      <HbrProductionAssemblyPath>@(_HbrProductionAssembly->'%(FullPath)')</HbrProductionAssemblyPath>
      <HbrProductionGhaPath>$([System.IO.Path]::ChangeExtension('$(HbrProductionAssemblyPath)', '.gha'))</HbrProductionGhaPath>
      <HbrProductionAssemblyFixture>$([MSBuild]::NormalizePath('$(TargetDir)', 'BIMBaoGui.Stage01.production.dll'))</HbrProductionAssemblyFixture>
      <HbrProductionGhaFixture>$([MSBuild]::NormalizePath('$(TargetDir)', 'BIMBaoGui.Stage01.gha'))</HbrProductionGhaFixture>
    </PropertyGroup>
    <Error Condition="!Exists('$(HbrProductionAssemblyPath)')"
           Text="Production BIMBaoGui.Stage01 TargetOutput does not exist: $(HbrProductionAssemblyPath)" />
    <Error Condition="!Exists('$(HbrProductionGhaPath)')"
           Text="Production BIMBaoGui.Stage01.gha does not exist: $(HbrProductionGhaPath)" />
    <GetFileHash Files="$(HbrProductionAssemblyPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HbrProductionAssemblyHash" />
    </GetFileHash>
    <GetFileHash Files="$(HbrProductionGhaPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HbrProductionGhaHash" />
    </GetFileHash>
    <Error Condition="'@(_HbrProductionAssemblyHash->'%(FileHash)')' != '@(_HbrProductionGhaHash->'%(FileHash)')'"
           Text="HBR production DLL/GHA content mismatch: $(HbrProductionAssemblyPath) -> $(HbrProductionGhaPath)." />
    <Copy SourceFiles="$(HbrProductionAssemblyPath)"
          DestinationFiles="$(HbrProductionAssemblyFixture)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(HbrProductionGhaPath)"
          DestinationFiles="$(HbrProductionGhaFixture)"
          SkipUnchangedFiles="true" />
    <GetFileHash Files="$(HbrProductionAssemblyFixture)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HbrProductionAssemblyFixtureHash" />
    </GetFileHash>
    <Error Condition="'@(_HbrProductionAssemblyHash->'%(FileHash)')' != '@(_HbrProductionAssemblyFixtureHash->'%(FileHash)')'"
           Text="Staged HBR production assembly hash does not match TargetOutput: $(HbrProductionAssemblyPath) -> $(HbrProductionAssemblyFixture)." />
    <GetFileHash Files="$(HbrProductionGhaFixture)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HbrProductionGhaFixtureHash" />
    </GetFileHash>
    <Error Condition="'@(_HbrProductionGhaHash->'%(FileHash)')' != '@(_HbrProductionGhaFixtureHash->'%(FileHash)')'"
           Text="Staged HBR production GHA hash does not match: $(HbrProductionGhaPath) -> $(HbrProductionGhaFixture)." />
  </Target>

