{
    admin off
    auto_https disable_redirects
    skip_install_trust
    servers {
        protocols h1 h2
    }
}

https://192.168.6.45:8443 {
    tls internal
    header -Server
    @allowed remote_ip __ALLOWED_CLIENT__
    handle @allowed {
        reverse_proxy hifc:8080
    }
    handle {
        respond "This source is not allowed." 403
    }
}
